 ],
 "frases": [
  {
   "id": "g",
   "bloque": "b0",
   "texto": "Sua geladeira esquenta a sua cozinha.",
   "inicio": 0.0,
   "fin": 2.66
  },
  {
   "id": "f1",
   "bloque": "b1",
   "texto": "E abrir a porta não refresca: esquenta mais.",
   "inicio": 3.14,
   "fin": 6.22
  },
  {
   "id": "f2",
   "bloque": "b2",
   "texto": "Porque a geladeira não fabrica frio.",
   "inicio": 6.7,
   "fin": 8.98
  },
  {
   "id": "f3",
   "bloque": "b2",
   "texto": "Ela tira o calor de dentro e leva para fora.",
   "inicio": 9.34,
   "fin": 12.02
  },
  {
   "id": "f4",
   "bloque": "b3",
   "texto": "Ele sai por esta grade aqui atrás.",
   "inicio": 12.5,
   "fin": 14.42
  },
  {
   "id": "f5",
   "bloque": "b4",
   "texto": "Só que, para empurrar esse calor, o motor gasta energia da tomada.",
   "inicio": 14.9,
   "fin": 19.58
  },
  {
   "id": "f6",
   "bloque": "b4",
   "texto": "E essa energia também vira calor, e sai junto pela grade.",
   "inicio": 19.94,
   "fin": 23.82
  },
  {
   "id": "f7",
   "bloque": "b5",
   "texto": "Aberta, ela puxa o calor da cozinha e devolve pela grade, com a tomada de brinde.",
   "inicio": 24.3,
   "fin": 29.9
  },
  {
   "id": "f8",
   "bloque": "b5",
   "texto": "No fundo, ela é um aquecedor que esfria por dentro.",
   "inicio": 30.26,
   "fin": 33.84
  },
  {
   "id": "f9",
   "bloque": "b6",
   "texto": "Manda para quem deixa a porta da geladeira aberta.",
   "inicio": 34.32,
   "fin": 37.86
  }
 ],
